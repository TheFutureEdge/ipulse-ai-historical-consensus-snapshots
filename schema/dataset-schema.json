{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "iPulse AI historical consensus snapshot row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id", "snapshot_id", "batch_id", "batch_generation_date",
    "forecast_anchor_start_date", "forecast_anchor_end_date",
    "scoring_completed_at_utc", "asset_symbol", "asset_name", "asset_category",
    "forecast_horizon", "ipulse_consensus_score", "annualized_expected_return_pct",
    "forecast_return_mad_pct", "direction_consistency", "direction_agreement",
    "risk_pressure_score", "risk_resilience_score", "financial_health_status",
    "voice_count", "advisor_count", "persona_count", "model_count",
    "source_algorithm_version", "public_methodology_version",
    "evaluation_methodology_version", "dataset_schema_version",
    "scoring_architecture_version", "risk_resilience_formula_version",
    "methodology_url", "record_checksum"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_id": {"type": "string"},
    "batch_id": {"type": "integer"},
    "batch_generation_date": {"type": "string", "format": "date"},
    "forecast_anchor_start_date": {"type": "string", "format": "date"},
    "forecast_anchor_end_date": {"type": "string", "format": "date"},
    "scoring_completed_at_utc": {"type": "string", "format": "date-time"},
    "asset_symbol": {"type": "string"},
    "asset_name": {"type": "string"},
    "asset_category": {"type": "string"},
    "asset_category_detailed": {"type": ["string", "null"]},
    "contract_or_ownership_type": {"type": ["string", "null"]},
    "ticker": {"type": ["string", "null"]},
    "exchange_code": {"type": ["string", "null"]},
    "currency": {"type": ["string", "null"]},
    "forecast_horizon": {"enum": ["1y", "5y"]},
    "ipulse_consensus_score": {"type": "integer"},
    "annualized_expected_return_pct": {"type": "number"},
    "forecast_return_mad_pct": {"type": "number", "minimum": 0},
    "direction_consistency": {"type": "number"},
    "direction_agreement": {"type": "number"},
    "risk_pressure_score": {"type": "number"},
    "risk_resilience_score": {"type": "number"},
    "financial_health_score": {"type": ["number", "null"]},
    "financial_health_status": {"type": "string"},
    "voice_count": {"type": "integer", "minimum": 1},
    "advisor_count": {"type": "integer", "minimum": 1},
    "persona_count": {"type": "integer", "minimum": 1},
    "model_count": {"type": "integer", "minimum": 1},
    "source_algorithm_version": {"const": "v2.5"},
    "public_methodology_version": {"const": "v7.4"},
    "evaluation_methodology_version": {"const": "not_applicable_not_evaluated"},
    "dataset_schema_version": {"const": "1.0.0"},
    "scoring_architecture_version": {"type": "string"},
    "risk_resilience_formula_version": {"type": "string"},
    "financial_health_formula_version": {"type": ["string", "null"]},
    "methodology_url": {"type": "string", "format": "uri"},
    "record_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
